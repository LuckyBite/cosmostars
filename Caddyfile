# Обратный прокси перед сервисом.
#
# SITE_ADDRESS задан доменом  → Caddy сам получает сертификат Let's Encrypt
#                               и продлевает его, порт 443.
# SITE_ADDRESS не задан       → обычный HTTP на 80 порту.
#
# Домена нет, а HTTPS нужен: подойдёт адрес вида 203-0-113-10.sslip.io —
# он разрешается в этот же IP, и сертификат на него выдаётся как на обычный
# домен. Покупать ничего не требуется.

{$SITE_ADDRESS::80} {
	encode zstd gzip
	reverse_proxy app:7860

	# Смена не кэшируется: ответ сервиса зависит от шага, на котором стоит
	# расчёт, и закэшированный ответ показал бы эксперту чужое состояние.
	@api path /api/*
	header @api Cache-Control "no-store"

	log {
		output stdout
		format console
	}
}
