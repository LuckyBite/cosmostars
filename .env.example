# Домен сервиса. Задан — Caddy получает сертификат Let's Encrypt автоматически,
# не задан — сервис отвечает по HTTP на 80 порту.
# Домена нет? Подойдёт 203-0-113-10.sslip.io, где цифры — IP вашего сервера.
SITE_ADDRESS=

# Сколько смен держать в памяти. Полная смена стоит 17 МБ на суточном сценарии
# и 26 МБ на перегруженном, плюс около 120 МБ на сам процесс и 20 МБ на прокси.
# 1 ГБ памяти — 12, 2 ГБ — 32, 4 ГБ и больше — 64.
COSMOSTARS_MAX_RUNS=32

# Готовый образ вместо сборки на сервере. Пусто — собирается локально из
# Dockerfile (`docker compose up -d --build`), что на машине с 1 ГБ памяти
# требует свопа. С этой строкой сборка не нужна:
#   COSMOSTARS_IMAGE=ghcr.io/luckybite/cosmostars:main
#   docker compose pull && docker compose up -d
COSMOSTARS_IMAGE=
